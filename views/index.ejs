<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Github Actions : Discussions</title>
    <!-- Google Fonts Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/public/css/styles.css" />
</head>
<body>
    <nav class="container-fluid col-12">

        <div class="nav-inner col-12">
            <!-- Logo -->
            <div class="container-fluid lg:col-8 md:col-8 sm:col-8 d-flex align-items-center justify-content-start p-0 h-100">
                <a href="/" class="text-decoration-none theme-contrast fs-2xl w-auto">Logo</a>
            </div>
            <!-- Navigation Links -->
            <div class="container-fluid lg:col-4 md:col-4 sm:col-4 d-flex align-items-center justify-content-end position-relative p-0 h-100">

                <!-- Login -->
                <a href="/" class="btn theme-primary theme-contrast m-0 mx-3 nav-icon-link">Login</a>
                <!-- Shopping Cart -->
                <a href="/" class="material-symbols-outlined text-decoration-none theme-contrast m-0 p-0 mx-3 nav-icon">shopping_bag</a>
            </div>
        </div>
    </nav>
    <header class="container-fluid col-12">

        <div class="row hero">

            <div class="container-fluid lg:col-6 md:col-6 sm:col-12 d-flex align-items-center justify-content-center flex-column">
                <h1 class="fs-6xl m-0 p-0 col-12 text-knockout gradient-green">Github Actions</h1>
                <p class="fs-lg m-0 p-0 col-12" style="color: rgb(0,0,0);">Recording interactions with repositories.</p>
            </div>
            <!-- image container -->
            <div class="container-fluid lg:col-6 md:col-6 sm:col-12 d-flex align-items-center justify-content-center"></div>
        </div>
    </header>
    <main class="container-fluid col-12 p-0">

        <!-- some content to fulfill here -->
        <section class="container-fluid col-12 d-flex align-items-center justify-content-center p-5">

            <div class="row align-items-start h-auto">
                <!-- card -->
                <div class="container-fluid lg:col-4 md:col-4 sm:col-12 d-flex align-items-center justify-content-center">

                    <!-- Discussions Event Type -->
                    <div class="card border-0 event-type-card">
                        <div class="card-body">
                            <div class="row">
                                <!-- icon -->
                                <div class="container-fluid lg:col-2 md:col-2 sm:col-12 d-flex align-items-start justify-content-center">
                                    <span class="material-symbols-outlined event-type-icon">conversation</span>
                                </div>
                                <div class="container-fluid lg:col-10 md:col-10 sm:col-12 d-flex align-items-center justify-content-center flex-column">
                                    <h3 class="text-start col-12 fs-lg event-type-card-text">Discussion</h3>
                                    <p class="text-start col-12 text-truncate event-type-card-text-definition">When a user starts a discussion on a repo</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- card -->
                <div class="container-fluid lg:col-4 md:col-4 sm:col-12 d-flex align-items-center justify-content-center">

                    <!-- Push Event Type -->
                    <div class="card border-0 event-type-card">
                        <div class="card-body">
                            <div class="row">
                                <!-- icon -->
                                <div class="container-fluid lg:col-2 md:col-2 sm:col-12 d-flex align-items-start justify-content-center">
                                    <span class="material-symbols-outlined event-type-icon">update</span>
                                </div>
                                <div class="container-fluid lg:col-10 md:col-10 sm:col-12 d-flex align-items-center justify-content-center flex-column">
                                    <h3 class="text-start col-12 fs-lg event-type-card-text">Push</h3>
                                    <p class="text-start col-12 text-truncate event-type-card-text-definition">Adding new or modified code to a repo</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- card -->
                <div class="container-fluid lg:col-4 md:col-4 sm:col-12 d-flex align-items-center justify-content-center">

                    <!-- Discussion Comment Event Type -->
                    <div class="card border-0 event-type-card">
                        <div class="card-body">
                            <div class="row">
                                <!-- icon -->
                                <div class="container-fluid lg:col-2 md:col-2 sm:col-12 d-flex align-items-start justify-content-center">
                                    <span class="material-symbols-outlined event-type-icon">comment</span>
                                </div>
                                <div class="container-fluid lg:col-10 md:col-10 sm:col-12 d-flex align-items-center justify-content-center flex-column">
                                    <h3 class="text-start col-12 fs-lg event-type-card-text">Discussion Comments</h3>
                                    <p class="text-start col-12 text-truncate event-type-card-text-definition">Replying to a discussion on a comment repo</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- what does github actions do? -->
        <section class="container-fluid col-12 d-flex align-items-center justify-content-center p-5">

            <!-- Track Discussions on Repos -->
        </section>
    </main>
    <!-- Bootstrap JS CDN -->
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
    <!-- JavaScripts -->
    <script src="/public/js/scripts.js"></script>
</body>
</html>